digraph container {
  rankdir=LR; compound=true; newrank=true;
  graph [fontname="Helvetica", fontsize=10, nodesep=0.45, ranksep=0.55, pad=0.2, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="#dbe9fb", color="#2563a8", penwidth=1.2, margin="0.15,0.08"];
  edge  [fontname="Helvetica", fontsize=8, color="#5b6b80", fontcolor="#5b6b80", arrowsize=0.7];
  buildsim [label=<<b>BuildSim</b><br/>[provided, Go]<br/>layers, equipment, doors,<br/>alerts, sessions, graph>, fillcolor="#e5e7eb", color="#6b7280", height=1.2];
  subgraph cluster_sys {
    label=<<b>Fire Detection &amp; Evacuation</b> [Software System]>; labeljust=l; style="dashed,rounded"; color="#2563a8"; fontcolor="#2563a8"; fontsize=10;
    sim   [label=<<b>fire-simulator</b><br/>[Container: Python]<br/>zone fire model, building clock>];
    sg    [label=<<b>sensor-gateway ×3</b><br/>[Container: Python]<br/>instrument models per floor>];
    mq    [label=<<b>mosquitto</b><br/>[Container: MQTT broker]<br/>users, ACL, retained, last will>, shape=cylinder, fillcolor="#e9e3f7", color="#6b4fa8"];
    agent [label=<<b>building-agent</b><br/>[Container: Python, LightGBM,<br/>scikit-learn] detect, decide,<br/>predict spread, plan evacuation>, fillcolor="#bcd6f7", penwidth=2];
    act   [label=<<b>actuator-gateway</b><br/>[Container: Python]<br/>sprinklers, purge dampers>];
    door  [label=<<b>door-gateway</b><br/>[Container: Python]<br/>doors, access control, lifts>];
    occ   [label=<<b>occupants</b><br/>[Container: Python]<br/>schedule, evacuation routes>];
    bridge[label=<<b>buildsim-bridge</b><br/>[Container: Python]<br/>display mirror, smoke coverage>];
    dbw   [label=<<b>db-writer</b><br/>[Container: Python]<br/>records everything>];
    db    [label=<<b>timescaledb</b><br/>[Container: PostgreSQL 16<br/>+ TimescaleDB] hot + warm>, shape=cylinder, fillcolor="#d7f2e3", color="#2f855a"];
    arch  [label=<<b>archiver</b><br/>[Container: Python]<br/>finished days to Parquet>];
    pq    [label=<<b>archive</b><br/>[Parquet files] cold>, shape=cylinder, fillcolor="#d7f2e3", color="#2f855a"];
    graf  [label=<<b>grafana</b><br/>[Container: Grafana 11]<br/>time series, decision log>];
  }
  sim -> buildsim  [label="PUT layers, effects;\nGET actuators, doors [REST]"];
  sg  -> buildsim  [label="GET layers [REST]"];
  sg  -> mq        [label="readings [MQTT q0]"];
  sim -> mq        [label="clock, scenario,\ntruth labels [MQTT]"];
  mq  -> agent     [label="readings, confirmed\nstates, progress [MQTT]"];
  agent -> mq      [label="commands, alerts, risk,\nplan, events [MQTT q1]"];
  mq  -> act       [label="actuator set [MQTT q1]"];
  act -> buildsim  [label="PUT actuator state [REST]"];
  mq  -> door      [label="door commands [MQTT q1]"];
  door -> buildsim [label="PUT /api/doors [REST]"];
  mq  -> occ       [label="plan, risk, clock [MQTT]"];
  occ -> buildsim  [label="entities, highlights,\nroute; GET route [REST]"];
  mq  -> bridge    [label="readings, alerts [MQTT]"];
  bridge -> buildsim [label="sensor values, alerts,\ncoverage [REST]"];
  mq  -> dbw       [label="everything [MQTT]"];
  dbw -> db        [label="COPY/INSERT [SQL]"];
  arch -> db       [label="SELECT [SQL]", dir=back];
  arch -> pq       [label="write"];
  graf -> db       [label="queries [SQL]"];
}
