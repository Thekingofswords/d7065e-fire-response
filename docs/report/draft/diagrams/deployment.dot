digraph deployment {
  rankdir=LR; compound=true;
  graph [fontname="Helvetica", fontsize=10, nodesep=0.45, ranksep=0.55, pad=0.2, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="#dbe9fb", color="#2563a8", penwidth=1.2, margin="0.15,0.08"];
  edge  [fontname="Helvetica", fontsize=8, color="#5b6b80", fontcolor="#5b6b80", arrowsize=0.7];
  subgraph cluster_laptop {
    label=<<b>Laptop</b> [Windows 11, Docker Desktop, WSL2] — the edge>; labeljust=l; style=rounded; color="#475569"; fontcolor="#334155";
    subgraph cluster_net {
      label="Docker network buildingsim_default"; style="dashed,rounded"; color="#94a3b8"; fontcolor="#64748b";
      bs [label=<<b>buildsim</b><br/>:9090 (loopback)>, fillcolor="#e5e7eb", color="#6b7280"];
      mq [label=<<b>mosquitto</b><br/>:1883 or :8883 TLS (loopback)>, fillcolor="#e9e3f7", color="#6b4fa8"];
      ctl [label=<<b>control loop</b><br/>fire-simulator, sensor-gateway ×3,<br/>building-agent, actuator-gateway,<br/>door-gateway>, fillcolor="#bcd6f7", penwidth=1.8];
      aux [label=<<b>display &amp; people</b><br/>buildsim-bridge, occupants>];
      data[label=<<b>data</b><br/>db-writer, timescaledb :5433,<br/>archiver, grafana :3000>, fillcolor="#d7f2e3", color="#2f855a"];
    }
    vol [label=<<b>volumes / bind mounts</b><br/>models/ (ro), archive/ (Parquet),<br/>mosquitto-data, timescale-data>, shape=folder, fillcolor="#fef3c7", color="#b7791f"];
    browser [label=<<b>Browser</b><br/>BuildSim viewer, Grafana>, fillcolor="#f1f5f9"];
  }
  cloud [label=<<b>External compute (optional)</b><br/>generate_dataset, train_model,<br/>train_anomaly, train_spread>, style="rounded,filled,dashed", fillcolor="#f8fafc", color="#94a3b8"];
  ctl -> mq [dir=both]; aux -> mq [dir=both]; data -> mq [dir=back];
  ctl -> bs; aux -> bs;
  ctl -> vol [label="models (ro)", style=dashed]; data -> vol [style=dashed];
  browser -> bs [label="HTTP/WebSocket"]; browser -> data [label="HTTP (Grafana)"];
  cloud -> vol [label="model files\n(off the critical path)", style=dashed];
}
