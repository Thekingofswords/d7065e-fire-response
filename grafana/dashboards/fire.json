{
  "uid": "fire-safety",
  "title": "Fire safety",
  "tags": [
    "fire"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "firedb"
        },
        "query": "SELECT DISTINCT level || '/' || room FROM samples_1m WHERE bucket > now() - interval '1 day' ORDER BY 1",
        "definition": "zones recorded in the last day",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "level0/A109",
          "value": "level0/A109"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Zones with a confirmed fire",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"fires\" FROM (\n  SELECT DISTINCT ON (level, room) data->>'state' AS state FROM events\n  WHERE type = 'room_state' AND time > now() - interval '6 hours'\n  ORDER BY level, room, time DESC) s WHERE state IN ('SUPPRESSING')"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Zones in alarm",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"alarms\" FROM (\n  SELECT DISTINCT ON (level, room) data->>'state' AS state FROM events\n  WHERE type = 'room_state' AND time > now() - interval '6 hours'\n  ORDER BY level, room, time DESC) s WHERE state IN ('ALARM')"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sprinklers on",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"sprinklers\" FROM (\n  SELECT DISTINCT ON (level, room, actuator) state FROM actuator_states\n  WHERE actuator = 'sprinkler' AND time > now() - interval '6 hours'\n  ORDER BY level, room, actuator, time DESC) s WHERE state = 'on'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Purge dampers open",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"dampers\" FROM (\n  SELECT DISTINCT ON (level, room, actuator) state FROM actuator_states\n  WHERE actuator = 'damper' AND time > now() - interval '6 hours'\n  ORDER BY level, room, actuator, time DESC) s WHERE state <> '0.0'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Services degraded",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"degraded\" FROM (\n  SELECT DISTINCT ON (data->>'service') data->>'state' AS state FROM events\n  WHERE type = 'service_state' AND time > now() - interval '1 day'\n  ORDER BY data->>'service', time DESC) s WHERE state = 'degraded'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rejected sensor messages",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum((value)::int), 0) AS \"rejected\" FROM events, jsonb_each_text(data->'rejected')\nWHERE type = 'data_quality' AND $__timeFilter(time)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "grey"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Zone $zone: temperature (\u00b0C)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval), max(temperature) AS \"sensor\", max(true_gas_temperature) AS \"truth\"\nFROM samples WHERE $__timeFilter(time) AND level || '/' || room = '$zone' GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Zone $zone: smoke (%/m) and CO (ppm)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval), max(smoke) AS \"smoke %/m\", max(co) AS \"CO ppm\",\n       max(true_smoke_obscuration) AS \"true smoke %/m\"\nFROM samples WHERE $__timeFilter(time) AND level || '/' || room = '$zone' GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Worst smoke per floor (%/m)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(bucket, '1m'), level AS metric, max(smoke_max) AS value\nFROM samples_1m WHERE $__timeFilter(bucket) GROUP BY 1, level ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Decision log (agent, actuators, doors, services)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time, type, severity, coalesce(level || '/' || room, '') AS zone, message\nFROM events\nWHERE $__timeFilter(time) AND type IN ('room_state', 'actuator_applied', 'command_rejected',\n  'actuator_write_failed', 'smoke_purge', 'door_policy', 'door_command_rejected',\n  'sensor_health', 'data_quality', 'service_state', 'evacuation_complete', 'evacuation_replan')\nORDER BY time DESC LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "message"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 700
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Commands and who sent them",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time, coalesce(level || '/' || room, '') AS zone, actuator, state, source, reason\nFROM commands WHERE $__timeFilter(time) ORDER BY time DESC LIMIT 300"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "People in the building",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, (data->>'present')::int AS \"people\" FROM events\nWHERE type = 'occupancy' AND $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Rejected sensor messages by reason",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "firedb"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "firedb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, key AS metric, value::int AS value FROM events, jsonb_each_text(data->'rejected')\nWHERE type = 'data_quality' AND $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      }
    }
  ]
}