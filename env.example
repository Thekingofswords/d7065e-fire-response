# Secrets for docker compose. Copy to .env (never commit .env), change every
# value, then regenerate the broker's password file:
#   sh mosquitto/make-passwd.sh
# Without a .env the development defaults ("<user>-dev", "fire") are used,
# which is fine on a laptop but not anywhere else.

# MQTT broker users, one per service (mosquitto/acl)
MQTT_PASSWORD_SIMULATOR=change-me-simulator
MQTT_PASSWORD_SENSORS=change-me-sensors
MQTT_PASSWORD_ACTUATORS=change-me-actuators
MQTT_PASSWORD_DOORS=change-me-doors
MQTT_PASSWORD_AGENT=change-me-agent
MQTT_PASSWORD_BRIDGE=change-me-bridge
MQTT_PASSWORD_RECORDER=change-me-recorder
MQTT_PASSWORD_EVACUATION=change-me-evacuation
MQTT_PASSWORD_ARCHIVER=change-me-archiver
MQTT_PASSWORD_OPERATOR=change-me-operator

# TimescaleDB (user "fire") and Grafana's admin
POSTGRES_PASSWORD=change-me-db
GRAFANA_ADMIN_PASSWORD=change-me-grafana
